# UPLIFT / MAWSIM — every value here is optional. With none of them set the
# application runs entirely on local Ollama, and with Ollama absent it runs on
# the deterministic stub. Nothing here is required for `make check`.

# --- Local inference (preferred everywhere it exists) ------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=qwen3:4b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=bge-m3:567m

# --- Free cloud tiers, used only where Ollama does not exist -----------------
GEMINI_API_KEY=
GROQ_API_KEY=

# Present and permanently unusable. services/api/core/llm.py refuses to select
# Anthropic even when this is set, and a test asserts the refusal.
ANTHROPIC_API_KEY=

# --- Budgets. Request counts, never tokens. ---------------------------------
QUOTA_GEMINI_REQUESTS=200
QUOTA_GROQ_REQUESTS=200

# --- Storage ----------------------------------------------------------------
UPLIFT_DB=data/processed/uplift.db

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
