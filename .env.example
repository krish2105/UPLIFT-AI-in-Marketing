# UPLIFT / MAWSIM — environment.
#
# NAMES ONLY. No value in this file is real, and none should ever be: a secret
# committed here is a secret in every clone and every zip of this repository.
# Real values live in your password manager and in the Render/Vercel dashboards.
#
# Every name below is READ BY THE CODE — asserted by
# tests/test_env_example_matches_the_code.py, because the previous version of
# this file listed three variables nothing had ever read (OLLAMA_FAST_MODEL,
# OLLAMA_VISION_MODEL, and OLLAMA_EMBED_MODEL, which the code actually calls
# UPLIFT_EMBED_MODEL) and omitted four that it did. A template that lies is
# worse than no template: it sends a future operator looking for a setting that
# does nothing.
#
# With none of these set the application runs on local Ollama, and with Ollama
# absent it runs on the deterministic stub. Nothing here is required for
# `make check`.

# --- Local inference (preferred everywhere it exists) ------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
# The embedding model, chosen by the A9 spike on cross-lingual margin.
UPLIFT_EMBED_MODEL=bge-m3:567m

# --- Free cloud tiers, used only where Ollama does not exist -----------------
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Declared so the constraint is visible, and NEVER READ. AnthropicProvider's
# available() is a hardcoded `return False` — it does not consult this variable,
# so zero paid inference does not depend on anyone remembering to leave it
# empty. Setting it has no effect whatsoever, which is a stronger guarantee than
# "we ignore it".
ANTHROPIC_API_KEY=

# --- Budgets. Request counts, never tokens. ---------------------------------
QUOTA_GEMINI_REQUESTS=200
QUOTA_GROQ_REQUESTS=200

# --- Identity ----------------------------------------------------------------
# The Admin capability. 64 hex characters; generate with
#   uv run python scripts/mint_token.py --new-secret
# Unset, there is no Admin role at all — the capability is absent rather than
# open, which is the correct default for a public URL. See docs/deploy.md.
UPLIFT_SIGNING_SECRET=

# --- Storage ----------------------------------------------------------------
# Repo-relative on purpose. /tmp does not survive from Render's build container
# to its runtime container, and the service comes up with every dataset empty.
UPLIFT_DB=data/processed/uplift.db

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Test-only. Set on the command line, not in a file. ----------------------
# Used by `make smoke-live` and scripts/verify_deploy.py to name the deployed
# pair. VERCEL is set by Vercel itself and is never set by hand.
LIVE_API_URL=
LIVE_WEB_URL=
